## Article 9 – Allowances and wartime bonuses

```catala
declaration scope MonetaryAllowance:
  input sm content Servicemember
  input has_position content YesNo
  input has_military_rank content YesNo
  input position_base_rate content money
  input service_rank_factor content integer
  input rank_base_rate content money
  input seniority_factor content integer
  input length_of_service_premium content money
  input hazard_duty_surcharge content money
  input qualification_surcharge content money
  input academic_surcharge content money
  input sso_bonus_rate content integer
  internal position_allowance content money
  internal rank_allowance content money
  internal monthly_additions content money
  internal special_bonus content money
  output base_monthly_allowance content money
  output total_monthly_allowance content money
  output pow_benefit_amount content money

scope MonetaryAllowance:
  definition position_allowance under condition
    has_position = Yes and sm.status = ActiveServicemember
    consequence equals position_base_rate * service_rank_factor

  definition rank_allowance under condition
    has_military_rank = Yes
    consequence equals rank_base_rate * seniority_factor

  definition monthly_additions under condition
    sm.status = ActiveServicemember
    consequence equals length_of_service_premium + hazard_duty_surcharge + qualification_surcharge + academic_surcharge

  definition base_monthly_allowance under condition
    has_position = Yes and sm.status = ActiveServicemember
    consequence equals position_allowance + rank_allowance + monthly_additions

  definition special_bonus under condition
    sm.formation = SpecialOperationsForces and has_position = Yes and sm.status = ActiveServicemember
    consequence equals base_monthly_allowance * sso_bonus_rate

  definition total_monthly_allowance under condition
    has_position = Yes and sm.status = ActiveServicemember
    consequence equals base_monthly_allowance + special_bonus

  definition pow_benefit_amount under condition
    sm.status = POW or sm.status = Hostage or sm.status = Internee or sm.status = Missing
    consequence equals base_monthly_allowance

  definition position_allowance equals 0.00
  definition rank_allowance equals 0.00
  definition monthly_additions equals 0.00
  definition base_monthly_allowance equals 0.00
  definition special_bonus equals 0.00
  definition total_monthly_allowance equals 0.00
  definition pow_benefit_amount equals 0.00
```

## Article 9-1 – Logistical provision

```catala
declaration scope LogisticalProvision:
  input sm content Servicemember
  input is_draftee_training content YesNo
  input transferred_to_new_post content YesNo
  input on_official_travel_ukraine_or_abroad content YesNo
  input state_provision_policy_in_force content YesNo
  internal family_transfer_allowance content YesNo
  internal medical_social_provision_gender_consideration content YesNo
  output food_entitlement content YesNo
  output clothing_entitlement content YesNo
  output moving_assistance content YesNo
  output travel_daily_allowance content YesNo
  output expense_reimbursement content YesNo

scope LogisticalProvision:
  definition food_entitlement under condition
    sm.status = ActiveServicemember or sm.status = ReservistOnTraining or sm.status = Conscript
    consequence equals Yes

  definition clothing_entitlement under condition
    sm.status = ActiveServicemember
    consequence equals Yes

  definition moving_assistance under condition
    (sm.status = ActiveServicememberOnContract or sm.status = OfficerDraftee or sm.status = ActiveServicemember) and transferred_to_new_post = Yes
    consequence equals Yes

  definition family_transfer_allowance equals Yes

  definition travel_daily_allowance under condition
    (sm.status = ActiveServicememberOnContract or sm.status = OfficerDraftee or sm.status = ActiveServicemember) and transferred_to_new_post = Yes
    consequence equals Yes

  definition expense_reimbursement under condition
    on_official_travel_ukraine_or_abroad = Yes
    consequence equals Yes

  definition medical_social_provision_gender_consideration under condition
    state_provision_policy_in_force = Yes
    consequence equals Yes

  definition food_entitlement equals No
  definition clothing_entitlement equals No
  definition moving_assistance equals No
  definition travel_daily_allowance equals No
  definition expense_reimbursement equals No
  definition medical_social_provision_gender_consideration equals No
```

## Article 9-2 – Wartime bonuses

```catala
declaration scope WartimeBonus:
  input sm content Servicemember
  input martial_law_in_force content YesNo
  input cmu_determined_amount content money
  input destroyed_or_captured_enemy_equipment content YesNo
  internal additional_monthly_bonus content money
  internal equipment_destruction_bonus content money
  output total_wartime_compensation content money

scope WartimeBonus:
  definition additional_monthly_bonus under condition
    martial_law_in_force = Yes and (sm.status = ActiveServicemember or sm.status = ReservistOnTraining or sm.status = Conscript)
    consequence equals cmu_determined_amount

  definition equipment_destruction_bonus under condition
    martial_law_in_force = Yes and (sm.status = ActiveServicemember or sm.status = ReservistOnTraining or sm.status = Conscript) and destroyed_or_captured_enemy_equipment = Yes
    consequence equals cmu_determined_amount

  definition total_wartime_compensation under condition
    martial_law_in_force = Yes and (sm.status = ActiveServicemember or sm.status = ReservistOnTraining or sm.status = Conscript)
    consequence equals additional_monthly_bonus + equipment_destruction_bonus

  definition additional_monthly_bonus equals 0.00
  definition equipment_destruction_bonus equals 0.00
  definition total_wartime_compensation equals 0.00
```
