```catala
declaration scope PensionAssistance:
  input sm content Servicemember
  input family_member content FamilyMember
  input service_years content integer
  input monthly_income content money
  input household_income_per_capita content money
  input has_disability content YesNo
  input disability_group content integer
  input age content integer
  input is_family_of_fallen content YesNo
  input is_pow content YesNo
  input cause_of_death_is_service content YesNo
  output service_pension_eligible content YesNo
  output disability_pension_eligible content YesNo
  output family_pension_eligible content YesNo
  output social_assistance_eligible content YesNo
  output monthly_pension_amount content money
  output disability_pension_amount content money
  output family_pension_amount content money
  output social_assistance_amount content money

scope PensionAssistance:
  definition service_pension_eligible under condition
    sm.status = ActiveServicemember and service_years >= 20
    consequence equals Yes

  definition disability_pension_eligible under condition
    has_disability = Yes and disability_caused_by_service = Yes
    consequence equals Yes

  definition family_pension_eligible under condition
    is_family_of_fallen = Yes and family_member.is_minor = Yes
    consequence equals Yes

  definition social_assistance_eligible under condition
    household_income_per_capita < 5000 and family_member.is_minor = Yes
    consequence equals Yes

  definition monthly_pension_amount under condition
    sm.status = ActiveServicemember and service_years >= 20
    consequence equals base_service_pension_rate

  definition disability_pension_amount under condition
    has_disability = Yes and disability_caused_by_service = Yes
    consequence equals base_disability_pension_rate

  definition family_pension_amount under condition
    is_family_of_fallen = Yes and family_member.is_minor = Yes
    consequence equals base_family_pension_rate

  definition social_assistance_amount under condition
    household_income_per_capita < 5000 and family_member.is_minor = Yes
    consequence equals social_assistance_base_rate
```
