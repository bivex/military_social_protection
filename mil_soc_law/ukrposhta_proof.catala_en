# Ukrposhta Sending Proof Verification (ПКМУ № 270)
#
# Models the legal requirements of Cabinet of Ministers Resolution No. 270 
# ("Правила надання послуг поштового зв'язку", в редакції ПКМУ № 1071 від 10.10.2023)
# to determine if a postal mailing constitutes legally binding proof of document delivery.
#
# Legal Citations:
# - Пункт 2 (підпункт 13): Рекомендоване поштове відправлення відстежується в системі
#   та вручається з підтвердженням вручення.
# - Пункт 8: Поділ відправлень на прості та реєстровані (рекомендовані та з оголошеною цінністю).
# - Пункт 17: Послуга опису вкладення полягає в підтвердженні вмісту відправлення 
#   із зазначенням його індивідуальних ознак (кількість, вид).
# - Пункт 32: Обов'язковість зазначення найменування та адреси одержувача і відправника.

```catala
declaration scope UkrposhtaSendingProof:
  # ---- Inputs ----
  # ПКМУ № 270, Пункт 8 & Пункт 2(13)
  input is_registered_or_valuable_mail content boolean
  # ПКМУ № 270, Пункт 17 (опис вкладення)
  input has_blank_form_107_inventory content boolean
  input inventory_completed_in_duplicate content boolean
  input inventory_stamped_and_signed_by_operator content boolean
  # ПКМУ № 270, Пункт 12 & 32 (чек та реквізити одержувача)
  input receipt_issued_by_operator content boolean
  input receipt_specifies_correct_recipient content boolean
  # ПКМУ № 270, Пункт 2(13) (відстеження та підтвердження вручення)
  input has_13_digit_tracking_number content boolean
  input tracking_status_delivered content boolean
  input delivery_signature_obtained content boolean

  # ---- Outputs ----
  output is_sending_proof_legally_binding content boolean
  output is_delivery_proof_legally_binding content boolean
  output overall_proof_compliant content boolean

scope UkrposhtaSendingProof:

  # 1. Sending proof is legally binding if it is registered/valuable mail,
  # has a correctly stamped and signed Form 107 inventory sheet, and the 
  # receipt names the correct unit or TRSS (ПКМУ № 270, Пункт 8, 17, 32).
  label sending_proof_yes exception default_sending_proof
  definition is_sending_proof_legally_binding under condition
    is_registered_or_valuable_mail and
    has_blank_form_107_inventory and
    inventory_completed_in_duplicate and
    inventory_stamped_and_signed_by_operator and
    receipt_issued_by_operator and
    receipt_specifies_correct_recipient
    consequence equals true

  label default_sending_proof
  definition is_sending_proof_legally_binding equals false

  # 2. Delivery proof is legally binding if the tracking system (ШПІ) 
  # shows the mail is delivered and a signature was obtained at destination 
  # (ПКМУ № 270, Пункт 2(13)).
  label delivery_proof_yes exception default_delivery_proof
  definition is_delivery_proof_legally_binding under condition
    has_13_digit_tracking_number and
    tracking_status_delivered and
    delivery_signature_obtained
    consequence equals true

  label default_delivery_proof
  definition is_delivery_proof_legally_binding equals false

  # 3. Overall compliance with CMU Resolution 270
  label overall_proof_yes exception default_overall_proof
  definition overall_proof_compliant under condition
    is_sending_proof_legally_binding and
    is_delivery_proof_legally_binding
    consequence equals true

  label default_overall_proof
  definition overall_proof_compliant equals false
```
