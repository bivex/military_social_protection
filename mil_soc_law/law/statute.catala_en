# Statute of Internal Service of the Armed Forces of Ukraine

> Using declarations

```catala
# --- Додаткові структури та переліки для Статуту ---

declaration enumeration MilitaryPost:
  -- BrigadeCommander
  -- DeputyCommanderLogistics
  -- BattalionCommander
  -- CompanyCommander
  -- ServiceChiefWithWarehouse
  -- OtherPost

declaration structure BarracksRequirements:
  data min_area_sq_m content decimal
  data max_area_sq_m content decimal
  data min_air_vol_cubic_m content decimal
  data max_air_vol_cubic_m content decimal

declaration enumeration RoomType:
  -- Barracks
  -- MedicalFacility
  -- OtherRoom

declaration enumeration WorkingWeek:
  -- FiveDays
  -- SixDays

declaration structure ConscriptLeave:
  data has_taken_oath content YesNo
  data has_disciplinary_ban content YesNo
  data is_on_daily_duty content YesNo

declaration enumeration ServicememberJob:
  -- Cook
  -- Baker
  -- MechanicDriver
  -- RegularDuty

# --- Основний Scope Статуту ---

scope InternalServiceStatute:
  context sm content Servicemember
  context sm_rank content MilitaryRank
  
  # --- Загальні положення ---
  
  context subject_to_statute content boolean
  rule subject_to_statute fulfilled if
    sm.status = ActiveServicemember or
    sm.status = ActiveServicememberOnContract or
    sm.status = Conscript or
    sm.status = OfficerDraftee or
    sm.status = ReservistOnTraining

  # =========================================================================
  # ПРАВА РЯДОВОГО ТА СЕРЖАНТСЬКОГО СКЛАДУ
  # (Солдати, матроси, молодші сержанти тощо)
  # =========================================================================

  context is_enlisted_or_junior_nco content boolean
  rule is_enlisted_or_junior_nco fulfilled if
    sm_rank = Recruit or
    sm_rank = Private or
    sm_rank = SeniorSoldier or
    sm_rank = JuniorSergeant or
    sm_rank = Sergeant

  # --- Статті 12 та 14: Право на звернення та захист ---
  # Право звертатися до командира з особистих/службових питань
  context right_to_address_commander content boolean
  rule right_to_address_commander fulfilled if is_enlisted_or_junior_nco

  # Право повідомляти про сексуальні домагання та дискримінацію спец. раднику
  context right_to_report_harassment_to_advisor content boolean
  rule right_to_report_harassment_to_advisor fulfilled if is_enlisted_or_junior_nco

  # --- Стаття 16-1: Право на інтелектуальну власність ---
  context created_intellectual_property_on_duty content boolean
  context right_to_file_ip_claim content boolean
  rule right_to_file_ip_claim fulfilled if
    is_enlisted_or_junior_nco and created_intellectual_property_on_duty

  # --- Стаття 22: Право на застосування зброї та фізичної сили ---
  context is_protecting_life content boolean
  context is_detaining_criminal content boolean
  context is_repelling_attack content boolean
  context is_preventing_weapon_seizure content boolean

  context right_to_use_force_and_weapons content boolean
  rule right_to_use_force_and_weapons fulfilled if
    is_enlisted_or_junior_nco and
    (is_protecting_life or 
     is_detaining_criminal or 
     is_repelling_attack or 
     is_preventing_weapon_seizure)

  # --- Стаття 199, 201, 203: Права на відпочинок ---
  # Мінімальна кількість годин сну на добу
  context right_to_daily_sleep_hours content integer
  rule right_to_daily_sleep_hours fulfilled if is_enlisted_or_junior_nco = 8

  # Право на відпочинок після обіду (у хвилинах)
  context right_to_post_lunch_rest_minutes content integer
  rule right_to_post_lunch_rest_minutes fulfilled if is_enlisted_or_junior_nco = 30

  # Компенсаційний вихідний, якщо працював у свято/вихідний (для контрактників)
  context worked_on_weekend content boolean
  context right_to_compensatory_day_off content boolean
  rule right_to_compensatory_day_off fulfilled if
    is_enlisted_or_junior_nco and 
    worked_on_weekend and 
    sm.status = ActiveServicememberOnContract

  # --- Стаття 216-217: Право на переміщення та звільнення ---
  # Право вільно переміщатися по території частини у вільний час
  context right_to_free_movement_in_base content boolean
  rule right_to_free_movement_in_base fulfilled if is_enlisted_or_junior_nco

  # Право на звільнення в день виборів (у годинах) для голосування
  context is_election_day content boolean
  context is_on_daily_duty content boolean
  context right_to_election_leave_hours content integer
  rule right_to_election_leave_hours fulfilled if
    is_enlisted_or_junior_nco and 
    is_election_day and 
    not is_on_daily_duty
    = 4
  rule right_to_election_leave_hours fulfilled = 0

  # Загальне право на звільнення за межі частини (для строковиків)
  context conscript_leave_info content ConscriptLeave
  context right_to_leave_base content boolean
  rule right_to_leave_base fulfilled if
    is_enlisted_or_junior_nco and
    sm.status = Conscript and
    conscript_leave_info.has_taken_oath = Yes and
    conscript_leave_info.has_disciplinary_ban = No and
    not is_on_daily_duty
  
  # Контрактники мають право вільно залишати межі гарнізону у вільний час (звітувавши командиру)
  rule right_to_leave_base fulfilled if
    is_enlisted_or_junior_nco and
    sm.status = ActiveServicememberOnContract

  # --- Стаття 254-257: Право на охорону здоров'я ---
  # Право на невідкладну медичну допомогу в будь-який час доби
  context right_to_emergency_medical_care content boolean
  rule right_to_emergency_medical_care fulfilled if is_enlisted_or_junior_nco

  # Максимальне звільнення від службових обов'язків за довідкою лікаря (у добах)
  context right_to_medical_exemption_days content integer
  rule right_to_medical_exemption_days fulfilled if is_enlisted_or_junior_nco = 6

  # --- Стаття 263-265: Санітарно-гігієнічні права ---
  # Право на миття в лазні або душі (разів на тиждень)
  context sm_job content ServicememberJob
  context right_to_bath_sessions_per_week content integer
  rule right_to_bath_sessions_per_week fulfilled if is_enlisted_or_junior_nco =
    match sm_job with
    | Cook -> 7
    | Baker -> 7
    | _ -> 1

  # Право на чисту зміну натільної/постільної білизни та рушників (разів на тиждень)
  context right_to_clean_underwear_per_week content integer
  rule right_to_clean_underwear_per_week fulfilled if is_enlisted_or_junior_nco =
    match sm_job with
    | Cook -> 2
    | Baker -> 2
    | _ -> 1

  # --- Стаття 293: Права під час несення добового наряду ---
  context is_free_shift_dnyuvalny content boolean
  context is_duty_sergeant content boolean
  
  # Черговий (наприклад, сержант по роті) має право спати 4 години, не знімаючи взуття
  context right_to_duty_sleep_hours content integer
  rule right_to_duty_sleep_hours fulfilled if
    is_enlisted_or_junior_nco and is_duty_sergeant
    = 4
    
  # Днювальний вільної зміни має право спати від відбою до підйому роздягненим
  context right_to_full_night_sleep_on_duty content boolean
  rule right_to_full_night_sleep_on_duty fulfilled if
    is_enlisted_or_junior_nco and is_free_shift_dnyuvalny
```
