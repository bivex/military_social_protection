# Statute of Internal Service of the Armed Forces of Ukraine

> Using declarations

```catala
# --- Додаткові структури та переліки для Статуту ---

declaration enumeration MilitaryPost:
  -- BrigadeCommander
  -- BrigadeChiefOfStaff
  -- BrigadeDeputyCommander
  -- BrigadeDeputyCommanderMoralPsych
  -- BrigadeDeputyCommanderArmament
  -- BrigadeDeputyCommanderLogistics
  -- BrigadeChiefOfArtillery
  -- BrigadeChiefOfAirDefense
  -- BrigadeChiefOfService
  -- BrigadeChiefOfEngineering
  -- BrigadeChiefOfNBCProtection
  -- BrigadeChiefOfMedicalService
  -- BrigadeChiefOfFinance
  -- BrigadeChiefOfPhysicalTraining
  -- BrigadeChiefOfIntelligence
  -- BrigadeChiefOfSignals
  -- BrigadeChiefOfMetrology
  -- BrigadeChiefOfRocketArtillery
  -- BrigadeChiefOfArmor
  -- BrigadeChiefOfAuto
  -- BrigadeChiefOfFuel
  -- BrigadeChiefOfFood
  -- BrigadeChiefOfClothing
  -- BrigadeLegalAdvisor
  -- BrigadeChaplain
  -- BrigadeChiefSergeant
  -- BattalionCommander
  -- BattalionChiefOfStaff
  -- BattalionDeputyCommander
  -- BattalionDeputyCommanderMoralPsych
  -- BattalionDeputyCommanderArmament
  -- BattalionChiefOfMedicalService
  -- BattalionChiefSergeant
  -- CompanyCommander
  -- CompanyDeputyCommander
  -- CompanyDeputyCommanderMoralPsych
  -- CompanyDeputyCommanderArmament
  -- CompanyChiefSergeant
  -- CompanySergeantMaterialSupport
  -- CompanyTacticalMedInstructor
  -- PlatoonCommander
  -- PlatoonChiefSergeant
  -- PlatoonInstructor
  -- SquadCommander
  -- PrivateSoldier
  -- OtherPost

declaration structure BarracksRequirements:
  data min_area_sq_m content decimal
  data max_area_sq_m content decimal
  data min_air_vol_cubic_m content decimal
  data max_air_vol_cubic_m content decimal

declaration enumeration RoomType:
  -- Barracks
  -- MedicalFacility
  -- OtherRoom

declaration enumeration WorkingWeek:
  -- FiveDays
  -- SixDays

declaration structure ConscriptLeave:
  data has_taken_oath content YesNo
  data has_disciplinary_ban content YesNo
  data is_on_daily_duty content YesNo

declaration enumeration ServicememberJob:
  -- Cook
  -- Baker
  -- MechanicDriver
  -- Firefighter
  -- RegularDuty

# Перелік видів добового наряду (Стаття 268)
declaration enumeration DailyDutyType:
  -- UnitDutyOfficer             # Черговий частини
  -- AssistantUnitDutyOfficer    # Помічник чергового частини
  -- GuardDuty                   # Варта
  -- ParkDutyOfficer             # Черговий парку
  -- StandbyUnit                 # Черговий підрозділ
  -- CheckpointDutyOfficer       # Черговий КПП
  -- HQDutyOfficer               # Черговий штабу
  -- MedicalDutyOfficer          # Черговий фельдшер/санінструктор
  -- CanteenDutyOfficer          # Черговий їдальні
  -- Signalist                   # Сигналіст-барабанщик
  -- FireSquad                   # Пожежний наряд
  -- CompanyDutyOfficer          # Черговий роти
  -- CompanyOrderly              # Днювальний роти
  -- None                        # Не в наряді

# --- Основний Scope Статуту ---

scope InternalServiceStatute:
  context sm content Servicemember
  context sm_rank content MilitaryRank
  context sm_job content ServicememberJob
  
  # --- Загальні положення ---
  
  context subject_to_statute content boolean
  rule subject_to_statute fulfilled if
    sm.status = ActiveServicemember or
    sm.status = ActiveServicememberOnContract or
    sm.status = Conscript or
    sm.status = OfficerDraftee or
    sm.status = ReservistOnTraining

  context is_enlisted_or_junior_nco content boolean
  rule is_enlisted_or_junior_nco fulfilled if
    sm_rank = Recruit or
    sm_rank = Private or
    sm_rank = SeniorSoldier or
    sm_rank = JuniorSergeant or
    sm_rank = Sergeant

  # =========================================================================
  # ДОБОВИЙ НАРЯД (Daily Duty)
  # =========================================================================

  context current_duty content DailyDutyType

  # --- Звільнення від нарядів ---
  
  # Стаття 193: Пожежники звільняються від нарядів, не пов'язаних з пожежною охороною
  context exempt_from_general_duty content boolean
  rule exempt_from_general_duty fulfilled if sm_job = Firefighter
  rule exempt_from_general_duty fulfilled = false
  
  # Стаття 269: Звільнення у зв'язку з материнством/дитинством (для жінок-військовослужбовців)
  context has_maternity_childcare_exemption content boolean
  rule exempt_from_general_duty fulfilled if has_maternity_childcare_exemption

  # --- Стаття 284: Підготовка до наряду ---
  # Мінімальний час для підготовки (у годинах)
  context duty_prep_time_hours content integer
  rule duty_prep_time_hours fulfilled if current_duty <> None = 3

  # Мінімальний час для відпочинку перед нарядом (у годинах)
  context duty_pre_rest_time_hours content integer
  rule duty_pre_rest_time_hours fulfilled if current_duty <> None = 1

  # --- Стаття 293: Відпочинок під час несення добового наряду ---
  # Визначаємо, чи має право особа відпочивати лежачи (спати)
  context can_sleep_on_duty content boolean
  rule can_sleep_on_duty fulfilled if current_duty <> None
  
  # Максимальна кількість годин сну для чергових (без роздягання)
  context max_sleep_hours_on_duty content integer
  rule max_sleep_hours_on_duty fulfilled if
    current_duty = UnitDutyOfficer or
    current_duty = AssistantUnitDutyOfficer or
    current_duty = CompanyDutyOfficer or
    current_duty = ParkDutyOfficer or
    current_duty = CheckpointDutyOfficer or
    current_duty = CanteenDutyOfficer or
    current_duty = MedicalDutyOfficer or
    current_duty = HQDutyOfficer
    = 4

  # Днювальні вільної зміни можуть спати від відбою до підйому
  context can_sleep_undressed_on_duty content boolean
  rule can_sleep_undressed_on_duty fulfilled if 
    current_duty = CompanyOrderly or 
    current_duty = Signalist

  # --- Стаття 294: Відпочинок ПІСЛЯ наряду ---
  # Звільнення від занять та робіт у день зміни з наряду
  context exempt_from_work_after_duty content boolean
  rule exempt_from_work_after_duty fulfilled if current_duty <> None

  # Компенсація вихідного дня, якщо наряд припав на вихідний/святковий день
  context duty_was_on_weekend content boolean
  context gets_compensatory_day_off content boolean
  
  rule gets_compensatory_day_off fulfilled if
    current_duty <> None and
    duty_was_on_weekend and
    (sm.status = ActiveServicememberOnContract or sm.status = OfficerDraftee)

  # =========================================================================
  # ІНШІ ПРАВА ТА НОРМИ (збережено з попередніх кроків)
  # =========================================================================

  # Право звертатися до командира з особистих/службових питань
  context right_to_address_commander content boolean
  rule right_to_address_commander fulfilled if is_enlisted_or_junior_nco

  # Право повідомляти про сексуальні домагання та дискримінацію спец. раднику
  context right_to_report_harassment_to_advisor content boolean
  rule right_to_report_harassment_to_advisor fulfilled if is_enlisted_or_junior_nco

  # Стаття 22: Право на застосування зброї
  context is_protecting_life content boolean
  context is_detaining_criminal content boolean
  context is_repelling_attack content boolean
  context is_preventing_weapon_seizure content boolean

  context right_to_use_force_and_weapons content boolean
  rule right_to_use_force_and_weapons fulfilled if
    (is_protecting_life or is_detaining_criminal or is_repelling_attack or is_preventing_weapon_seizure)

  # Норми казарми
  context barracks_reqs content BarracksRequirements
  rule barracks_reqs.min_area_sq_m fulfilled = 2.5
  rule barracks_reqs.max_area_sq_m fulfilled = 4.0
  rule barracks_reqs.min_air_vol_cubic_m fulfilled = 9.0
  rule barracks_reqs.max_air_vol_cubic_m fulfilled = 12.0

  # Право на звільнення в місто (для строковиків)
  context conscript_leave_info content ConscriptLeave
  context right_to_leave_base content boolean
  rule right_to_leave_base fulfilled if
    sm.status = Conscript and
    conscript_leave_info.has_taken_oath = Yes and
    conscript_leave_info.has_disciplinary_ban = No and
    current_duty = None
  
  rule right_to_leave_base fulfilled if sm.status = ActiveServicememberOnContract
```
