```catala
declaration scope HealthcareEntitlement:
  input sm content Servicemember
  input family_member content FamilyMember
  input is_ato_participant content YesNo
  input is_pow_survivor content YesNo
  input is_war_participant content YesNo
  input is_medical_need content YesNo
  input requires_sanatorium content YesNo
  input household_income_per_capita content money
  input child_sick content YesNo
  input child_hospitalization content YesNo
  input family_member_is_protected content YesNo
  input no_public_hospital_in_residence_area content YesNo
  input actual_service_in_war_zones content YesNo
  input unlawfully_deprived_liberty_and_recently_released content YesNo
  input exceeded_once_per_year content YesNo
  input post_stationary_treatment_per_military_medical_board content YesNo
  input war_time_participant content YesNo
  input child_age content integer
  internal reintegration_program_entitled content YesNo
  internal free_sanatorium_after_hospital content YesNo
  output free_military_medical_care content YesNo
  output psychological_support content YesNo
  output sanatorium_right content YesNo
  output child_care_leave_medical content YesNo
  output infertility_preservation_right content YesNo

scope HealthcareEntitlement:
  label free_military_medical_care_cond exception default_free_military_medical_care
  definition free_military_medical_care under condition
    sm.status = ActiveServicemember or sm.status = ReservistOnTraining or sm.status = Conscript or sm.status = SpecialPeriod
    or (family_member_is_protected = Yes and no_public_hospital_in_residence_area = Yes)
    consequence equals Yes

  label psychological_support_cond exception default_psychological_support
  definition psychological_support under condition
    (is_ato_participant = Yes or actual_service_in_war_zones = Yes or is_war_participant = Yes) and is_pow_survivor = Yes
    consequence equals Yes

  label reintegration_program_entitled_cond exception default_reintegration_program_entitled
  definition reintegration_program_entitled under condition
    unlawfully_deprived_liberty_and_recently_released = Yes
    consequence equals Yes

  label sanatorium_right_cond exception default_sanatorium_right
  definition sanatorium_right under condition
    (sm.status = ActiveServicemember or sm.status = ReservistOnTraining or sm.status = Conscript or sm.status = SpecialPeriod) and exceeded_once_per_year = No
    consequence equals Yes

  label free_sanatorium_after_hospital_cond exception default_free_sanatorium_after_hospital
  definition free_sanatorium_after_hospital under condition
    post_stationary_treatment_per_military_medical_board = Yes
    consequence equals Yes

  label child_care_leave_medical_cond exception default_child_care_leave_medical
  definition child_care_leave_medical under condition
    child_sick = Yes and child_age < 14
    consequence equals Yes

  label infertility_preservation_right_cond exception default_infertility_preservation_right
  definition infertility_preservation_right under condition
    (sm.status = ActiveServicemember or sm.status = ReservistOnTraining or sm.status = Conscript or sm.status = SpecialPeriod) and war_time_participant = Yes
    consequence equals Yes

  label default_free_military_medical_care
  definition free_military_medical_care equals No
  label default_psychological_support
  definition psychological_support equals No
  label default_reintegration_program_entitled
  definition reintegration_program_entitled equals No
  label default_sanatorium_right
  definition sanatorium_right equals No
  label default_free_sanatorium_after_hospital
  definition free_sanatorium_after_hospital equals No
  label default_child_care_leave_medical
  definition child_care_leave_medical equals No
  label default_infertility_preservation_right
  definition infertility_preservation_right equals No
```
